# ---- App ----
APP_ENV=development              # development | production
PORT=8088
TZ_GYM=America/Santiago

# ---- Base de datos (PostgreSQL 10+) ----
DATABASE_URL=postgres://bloodandsand:secret@localhost:55432/bloodandsand?sslmode=disable

# ---- Sesiones ----
JWT_SECRET=                      # mínimo 32 caracteres aleatorios
ACCESS_TTL=15m
REFRESH_TTL=720h                 # 30 días
COOKIE_SECURE=                   # vacío = true en producción
COOKIE_DOMAIN=                   # vacío = dominio exacto de la API

# ---- URLs ----
CORS_ORIGINS=http://localhost:4200          # separadas por coma
FRONTEND_URL=http://localhost:4200          # donde vuelve el comprador tras pagar
PUBLIC_API_URL=http://localhost:8088        # base pública de la API (callbacks de pago)

# ---- Admin inicial (se crea solo si no hay ningún admin) ----
ADMIN_EMAIL=admin@bloodandsand.cl
ADMIN_PASSWORD=

# ---- Pagos ----
PAYMENT_PROVIDERS=fake,webpay               # fake | webpay | mercadopago (fake no se permite en producción)
WEBPAY_ENV=integration                      # integration | production
WEBPAY_COMMERCE_CODE=597055555532           # código de integración público de Transbank
WEBPAY_API_SECRET=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
MP_ACCESS_TOKEN=                            # TEST-… para sandbox
MP_WEBHOOK_SECRET=                          # "clave secreta" de webhooks en el panel de Mercado Pago
MP_SANDBOX=true

# ---- Web Push (go run ./cmd/vapidgen) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@bloodandsand.cl

# ---- Reglas del negocio ----
BOOKING_HOLD=15m                 # cupo reservado mientras se paga
CANCEL_LIMIT=3h                  # cancelar antes de esto devuelve la clase del plan
REMINDER_BEFORE=2h
GENERATE_DAYS_AHEAD=21           # cuántos días de clases se generan desde el horario semanal
